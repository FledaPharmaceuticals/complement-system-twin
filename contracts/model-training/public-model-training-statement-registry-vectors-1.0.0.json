  "statementIdOrderingVectors": [
    {
      "name": "shorter_exact_prefix_first",
      "input": [
        "A.1",
        "A",
        "A.",
        "A.0"
      ],
      "expected": [
        "A",
        "A.",
        "A.0",
        "A.1"
      ]
    },
    {
      "name": "mixed_case_and_punctuation",
      "input": [
        "a_",
        "A_",
        "a.",
        "A.",
        "a-",
        "A-",
        "a0",
        "A0"
      ],
      "expected": [
        "A-",
        "A.",
        "A0",
        "A_",
        "a-",
        "a.",
        "a0",
        "a_"
      ]
    }
  ],
  "jcsVectors": [
    {
      "name": "object_order",
      "value": {
        "z": 1,
        "a": [
          3,
          2,
          1
