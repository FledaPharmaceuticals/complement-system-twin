  },
  "httpStatusRules": {
    "400": { "action": "display_input_error", "legacyFallback": false },
    "404": { "action": "report_deployment_error", "legacyFallback": false },
    "413": { "action": "display_service_limit", "legacyFallback": false },
    "422": { "action": "display_input_error", "legacyFallback": false },
    "429": { "action": "display_service_limit_and_retry_after", "legacyFallback": false },
    "5xx": { "action": "legacy_fallback_when_eligible", "legacyFallback": true }
  },
