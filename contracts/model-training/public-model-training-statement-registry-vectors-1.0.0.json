      "expected": "reject",
      "expectedException": "InvalidPublicStatementRegistry",
      "expectedPath": "$.expectedReleaseCommit"
    },
    {
      "name": "raw_bytes_differ_from_committed_blob",
      "expectedSchemaVersion": "1.0.0",
